# =============================================================================
# .env.production.example — SGA Engeativos (cPanel deploy)
# =============================================================================
# Copie este arquivo como `.env` no servidor de produção e preencha os
# valores entre <colchetes>. NÃO faça commit do `.env` real.
#
# Como gerar APP_KEY no servidor (depois de extrair o ZIP):
#   php artisan key:generate --force
#
# Para aplicar mudanças aqui sem reiniciar PHP-FPM:
#   php artisan config:clear && php artisan config:cache
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_NAME="SGA Engeativos"
APP_ENV=production
APP_KEY=                                       # gerar com `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://sga-engeativos.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs (CUIDADO: stack/single em prod cresce rápido — considere daily)
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning                              # error/warning em prod, debug só em troubleshooting

# -----------------------------------------------------------------------------
# Banco de dados (MySQL no cPanel)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<cpanel_db>                        # ex: usuario_sga
DB_USERNAME=<cpanel_user>                      # ex: usuario_sga
DB_PASSWORD=<cpanel_password>

# -----------------------------------------------------------------------------
# Sessão / Cookies (HTTPS obrigatório!)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database                        # robusto: persiste no DB
SESSION_LIFETIME=43200                         # 30 dias (longo p/ PWA mobile)
SESSION_ENCRYPT=true                           # cifra payload da sessão
SESSION_PATH=/
SESSION_DOMAIN=null                            # usa o domínio atual
SESSION_SECURE_COOKIE=true                     # só envia cookie por HTTPS
SESSION_SAME_SITE=lax

# Sanctum (se algum dia for usar API stateful)
SANCTUM_STATEFUL_DOMAINS=sga-engeativos.com.br

# -----------------------------------------------------------------------------
# Cache / Queue / Broadcast / Filesystem
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# WebAuthn / Passkeys (CRÍTICO para biometria)
# -----------------------------------------------------------------------------
# RP_ID deve ser EXATAMENTE o hostname do APP_URL (sem https://, sem porta).
# ORIGINS deve incluir o origin completo (com https://).
WEBAUTHN_NAME="SGA Engeativos"
WEBAUTHN_ID=sga-engeativos.com.br
WEBAUTHN_ORIGINS=https://sga-engeativos.com.br

# -----------------------------------------------------------------------------
# Mail (SMTP do cPanel ou de provedor externo tipo Mailgun/SES)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<smtp_host>                          # ex: mail.sga-engeativos.com.br
MAIL_PORT=587
MAIL_USERNAME=<smtp_user>
MAIL_PASSWORD=<smtp_password>
MAIL_SCHEME=tls                                # tls ou ssl
MAIL_FROM_ADDRESS="noreply@sga-engeativos.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Frota — Alertas diários de preventivas vencidas
# -----------------------------------------------------------------------------
FROTA_ALERTAS_EMAIL=                           # vazio = primeiro super_admin
FROTA_ALERTAS_INCLUIR_AGUARDANDO=false

# -----------------------------------------------------------------------------
# OneDrive / Microsoft Graph (uploads de anexos)
# -----------------------------------------------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SITE_ID=
MS_GRAPH_ROOT_FOLDER=SGA-Engeativos

# -----------------------------------------------------------------------------
# Jarvis (IA opcional) — desligue se não usar (mantém driver heuristic)
# -----------------------------------------------------------------------------
JARVIS_LLM_DRIVER=heuristic                    # 'heuristic' (sem API) | 'anthropic' (real)
ANTHROPIC_API_KEY=                             # obrigatório se driver=anthropic
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-6
JARVIS_ANTHROPIC_MAX_TOKENS=1024
JARVIS_TOOL_TIMEOUT=30
JARVIS_MAX_MESSAGES=1000

# -----------------------------------------------------------------------------
# AWS S3 (não usado por padrão — só preencha se migrar uploads p/ S3)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Vite (não precisa mudar — só lido durante build local)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
