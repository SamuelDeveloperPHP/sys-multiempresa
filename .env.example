APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frota: emails que recebem alertas diarios de preventivas vencidas
# (separar por virgula). Vazio = envia para o primeiro super_admin.
FROTA_ALERTAS_EMAIL=
# Incluir tambem ciclos ainda "aguardando" (nao so vencidos/prontos)?
FROTA_ALERTAS_INCLUIR_AGUARDANDO=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# OneDrive / Microsoft Graph (upload de anexos de funcionários)
# ---------------------------------------------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SITE_ID=
MS_GRAPH_ROOT_FOLDER=SGA-Engeativos

# ---------------------------------------------------------------------------
# Jarvis — Módulo de IA
# ---------------------------------------------------------------------------
# Driver do LLM: 'heuristic' (dev, sem API) | 'anthropic' (produção)
JARVIS_LLM_DRIVER=heuristic

# Chave da API Anthropic (obrigatória quando JARVIS_LLM_DRIVER=anthropic)
ANTHROPIC_API_KEY=

# Modelo Claude a ser usado (padrão: claude-sonnet-4-6)
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-6

# Máximo de tokens na resposta do LLM
JARVIS_ANTHROPIC_MAX_TOKENS=1024

# Timeout em segundos para execução de tools
JARVIS_TOOL_TIMEOUT=30

# Máximo de mensagens por conversa
JARVIS_MAX_MESSAGES=1000

# ---------------------------------------------------------------------------
# Banco de dados — produção (substitua SQLite por MySQL/PostgreSQL)
# ---------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sys_multiempresa
# DB_USERNAME=root
# DB_PASSWORD=secret
